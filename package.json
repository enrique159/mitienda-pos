{
  "name": "mitienda-pos",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "author": "Enrique Marín Hirales",
  "license": "MIT",
  "main": "electron-build/main.cjs",
  "scripts": {
    "vite:dev": "vite --host --mode dev",
    "dev:local": "vite  --host",
    "dev": "npm run electron:dev",
    "build": "vue-tsc --noEmit && npm run packages:build && vite build",
    "preview": "vite preview",
    "packages:build": "node ./scripts/build-electron-packages.cjs",
    "packages:clean": "node ./scripts/clean-electron-packages.cjs",
    "packages:check": "tsc -p tsconfig.electron.json --noEmit",
    "electron": "wait-on tcp:5173 && npm run packages:build && cross-env electron .",
    "electron:watch": "node ./scripts/electron-watch.cjs",
    "electron:pack": "npm run packages:build && electron-builder --dir",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run vite:dev\" \"npm run electron:watch\"",
    "electron:builder": "npm run packages:build && electron-builder",
    "build:for:electron": "vue-tsc --noEmit && npm run packages:build && cross-env ELECTRON=true vite build",
    "app:build": "npm run prepare:dir && npm run build:for:electron && npm run electron:builder",
    "prepare:dir": "node ./scripts/prepare-dir.js",
    "migrate:latest": "npm run packages:build && knex migrate:latest --knexfile electron-build/app/database/knexfile.cjs",
    "migrate:make": "npm run packages:build && knex migrate:make --knexfile electron-build/app/database/knexfile.cjs"
  },
  "dependencies": {
    "@google/genai": "1.25.0",
    "@pablotheblink/flashyjs": "^1.0.5",
    "@tabler/icons-vue": "3.34.1",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "@vuepic/vue-datepicker": "^11.0.1",
    "@vueuse/core": "^12.3.0",
    "@vueuse/integrations": "^12.3.0",
    "axios": "1.10.0",
    "dayjs": "^1.11.13",
    "jwt-decode": "^4.0.0",
    "knex": "^3.1.0",
    "mime-types": "^3.0.1",
    "openai": "6.5.0",
    "pinia": "3.0.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.2",
    "sqlite3": "^5.1.7",
    "to-words": "^4.6.0",
    "uuid": "^11.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue3-toastify": "^0.2.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@typescript-eslint/parser": "^7.14.1",
    "@vitejs/plugin-vue": "^5.0.5",
    "autoprefixer": "^10.4.20",
    "babel-eslint": "^10.1.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "daisyui": "^4.12.23",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "electron-devtools-installer": "^3.2.0",
    "eslint": "^8.36.0",
    "eslint-plugin-vue": "^9.26.0",
    "postcss": "^8.4.49",
    "sass": "^1.77.6",
    "sass-loader": "^14.2.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.3.1",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vue-tsc": "^2.0.21",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "net.mitiendapos.app",
    "productName": "Mitienda",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "electron-build/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      "resources/**/*"
    ],
    "win": {
      "icon": "./public/icon.png"
    },
    "mac": {
      "icon": "./public/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": null,
      "entitlementsInherit": null
    },
    "afterSign": null,
    "afterAllArtifactBuild": null
  }
}
